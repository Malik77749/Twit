{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["phone", "handle"],
      "$uid": {
        ".read": true,
        ".write": "auth.uid === $uid && ((!data.exists() && newData.child('isAdmin').val() !== true && newData.child('verified').val() !== 'blue') || (data.exists() && newData.child('uid').val() === data.child('uid').val() && newData.child('numericId').val() === data.child('numericId').val() && newData.child('isAdmin').val() === data.child('isAdmin').val() && newData.child('verified').val() === data.child('verified').val() && newData.child('verificationStart').val() === data.child('verificationStart').val() && newData.child('verificationEnd').val() === data.child('verificationEnd').val() && newData.child('accountStatus').val() === data.child('accountStatus').val() && newData.child('provider').val() === data.child('provider').val()))",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
        },
        "bio": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "profilePicture": {
          ".validate": "newData.isString()"
        },
        "isAdmin": {
          ".write": false
        },
        "verified": {
          ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
          ".validate": "newData.isBoolean() || newData.val() === 'blue'"
        },
        "verificationStart": { ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true", ".validate": "newData.isString() || newData.val() === null" },
        "verificationEnd": { ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true", ".validate": "newData.isString() || newData.val() === null" },
        "followers": {
          ".validate": "newData.isNumber()"
        },
        "following": {
          ".validate": "newData.isNumber()"
        },
        "handle": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.]{3,20}$/) && (data.val() === newData.val() || root.child('handles').child(newData.val()).val() === auth.uid)"
        },
        "numericId": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{6,12}$/) && (data.val() === newData.val() || root.child('numericIds').child(newData.val()).val() === auth.uid)"
        },
        "messagePrivacy": { ".validate": "newData.isString() && (newData.val() === 'everyone' || newData.val() === 'following' || newData.val() === 'mutual' || newData.val() === 'none')" },
        "$other": { ".validate": true }
      }
    },

    "handles": {
      "$handle": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (data.val() === auth.uid && newData.val() === auth.uid))",
        ".validate": "newData.isString() && newData.val() === auth.uid && $handle.matches(/^[a-z0-9_.]{3,20}$/)"
      }
    },

    "numericIds": {
      "$numericId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.isString() && newData.val() === auth.uid) || (data.val() === auth.uid && !newData.exists()) || (data.val() === auth.uid && newData.val() === auth.uid))",
        ".validate": "newData.isString() && newData.val() === auth.uid && $numericId.matches(/^[0-9]{6,12}$/)"
      }
    },

    "posts": {
      ".read": "auth != null",
      ".indexOn": ["timestamp"],
      "$postId": {
        ".read": true,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid))",
          "content": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "userId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "timestamp": {
          ".validate": "newData.isString()"
        },
        "likes": {
          ".write": "auth != null && newData.isNumber() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)",
          ".validate": "newData.isNumber()"
        },
        "retweets": {
          ".write": "auth != null && newData.isNumber() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)",
          ".validate": "newData.isNumber()"
        },
        "views": {
          ".write": "auth != null && newData.isNumber() && newData.val() === data.val() + 1",
          ".validate": "newData.isNumber()"
        },
        "imageUrl": {
          ".validate": "newData.isString()"
        },
        "videoUrl": {
          ".validate": "newData.isString()"
        },
        "edited": { ".validate": "newData.isBoolean()" },
        "editedAt": { ".validate": "newData.isString()" },
        "commentCount": {
          ".write": "auth != null && newData.isNumber() && newData.val() === data.val() + 1",
          ".validate": "newData.isNumber()"
        },
        "quotedPostId": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "userName": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "userAvatar": { ".validate": "newData.isString()" },
        "userHandle": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "media": { ".validate": "newData.hasChildren()" },
        "mediaUrls": { ".validate": "newData.val() != null" },
        "replySetting": { ".validate": "newData.isString() && (newData.val() === 'everyone' || newData.val() === 'following')" },
        "location": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "communityId": { ".validate": "newData.isString() && newData.val().length <= 80" },
        "hidden": { ".validate": "newData.isBoolean()" },
        "pinned": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    },

    "comments": {
      ".read": "auth != null",
      "$postId": {
        ".indexOn": ["timestamp"],
        "$commentId": {
          ".read": true,
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid))",
          "content": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "userId": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "timestamp": {
            ".validate": "newData.isString()"
          },
                    "userName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "userAvatar": { ".validate": "newData.isString()" },
          "parentCommentId": { ".validate": "newData.isString() || newData.val() === null" },
          "$other": { ".validate": false }
        }
      }
    },
    "blocks": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$targetUid": {
          ".write": "auth.uid === $uid && $uid !== $targetUid",
          ".validate": "newData.hasChildren(['timestamp'])",
          "timestamp": { ".validate": "newData.isString()" }
        }
      }
    },
    "mutes": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$targetUid": {
          ".write": "auth.uid === $uid && $uid !== $targetUid",
          ".validate": "newData.hasChildren(['timestamp'])",
          "timestamp": { ".validate": "newData.isString()" }
        }
      }
    },
    "mutedWords": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$word": {
          ".write": "auth.uid === $uid",
          ".validate": "newData.hasChildren(['word','timestamp']) && newData.child('word').isString() && newData.child('timestamp').isString()"
        }
      }
    },
    "likes": {
      ".read": "auth != null",
      "$postId": {
        "$uid": {
          ".read": true,
          ".write": "auth.uid === $uid"
        }
      }
    },

    "bookmarks": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$postId": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid"
        }
      }
    },

    "followers": {
      ".read": "auth != null",
      "$targetUid": {
        "$followerUid": {
          ".read": true,
          ".write": "auth.uid === $followerUid"
        }
      }
    },

    "lists": {
      "$ownerUid": {
        ".read": "auth.uid === $ownerUid",
        "$listId": {
          ".read": "auth.uid === $ownerUid",
          ".write": "auth.uid === $ownerUid",
          ".validate": "newData.hasChildren(['name','isPrivate','memberCount','createdAt','updatedAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 80 && newData.child('isPrivate').isBoolean() && newData.child('memberCount').isNumber() && newData.child('memberCount').val() >= 0 && newData.child('createdAt').isString() && newData.child('updatedAt').isString()"
        }
      }
    },

    "listMembers": {
      "$ownerUid": {
        ".read": "auth.uid === $ownerUid",
        "$listId": {
          ".read": "auth.uid === $ownerUid",
          "$memberUid": {
            ".write": "auth.uid === $ownerUid && root.child('lists').child($ownerUid).child($listId).exists()",
            ".validate": "newData.hasChildren(['addedAt']) && newData.child('addedAt').isString()"
          }
        }
      }
    },

    "retweets": {
      ".read": "auth != null",
      ".indexOn": ["originalPostId"],
      "$retweetId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.exists() && data.child('userId').val() === auth.uid))",
        "userId": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "originalPostId": {
          ".validate": "newData.isString()"
        },
        "timestamp": {
          ".validate": "newData.isString()"
        }
      }
    },

    "notifications": {
      "$uid": {
        ".read": "auth.uid === $uid",
        "$notifId": {
          ".read": "auth.uid === $uid",
          ".write": "auth != null && (root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && newData.child('actorId').val() === auth.uid) || (auth.uid === $uid && data.exists() && newData.child('message').val() === data.child('message').val() && newData.child('actorId').val() === data.child('actorId').val() && newData.child('type').val() === data.child('type').val() && newData.child('read').val() === true))",
          ".validate": "newData.hasChildren(['timestamp','read']) && newData.child('timestamp').isString() && newData.child('read').isBoolean()"
        }
      }
    },

    "reports": {
      ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$reportId": {
        ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
        ".write": "auth != null && ((!data.exists() && newData.child('reporterId').val() === auth.uid && newData.child('status').val() === 'pending') || (data.exists() && root.child('users').child(auth.uid).child('isAdmin').val() === true))",
        ".validate": "newData.hasChildren(['reporterId','reason','status','timestamp','type']) && newData.child('reporterId').isString() && newData.child('reason').isString() && newData.child('reason').val().length <= 500 && newData.child('status').isString() && newData.child('type').isString()"
      }
    },

    "verificationThreads": {
      ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true",
        "meta": {
          ".write": "auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true",
          ".validate": "newData.hasChildren(['userId','status','lastMessageAt']) && newData.child('userId').val() === $uid && newData.child('status').isString() && newData.child('lastMessageAt').isString()"
        },
        "messages": {
          "$messageId": {
            ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true || (!data.exists() && auth.uid === $uid && newData.child('senderId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['senderId','senderRole','text','timestamp']) && newData.child('senderId').isString() && newData.child('senderRole').isString() && newData.child('text').isString() && newData.child('text').val().length <= 1000 && newData.child('timestamp').isString()"
          }
        }
      }
    },
    "verificationSettings": {
      ".read": "auth != null",
      ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },
    "warnings": {
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true",
        "$warningId": {
          ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
          ".validate": "newData.hasChildren(['message','timestamp','adminId']) && newData.child('message').isString() && newData.child('message').val().length <= 500 && newData.child('timestamp').isString() && newData.child('adminId').isString()"
        }
      }
    },
    "bans": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$uid": {
        ".read": "auth.uid === $uid || root.child('users').child(auth.uid).child('isAdmin').val() === true",
                ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
        "status": { ".validate": "newData.isString() && (newData.val() === 'banned' || newData.val() === 'suspended')" },
        "durationDays": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 365" },
        "expiresAt": { ".validate": "newData.isString()" },
        "reason": { ".validate": "newData.isString() && newData.val().length <= 500" },
        "timestamp": { ".validate": "newData.isString()" }
      }
    },
    "auditLog": {
      ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
      "$logId": {
        ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
        ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
      }
    },

    "siteSettings": {
      ".read": "root.child('users').child(auth.uid).child('isAdmin').val() === true",
      ".write": "root.child('users').child(auth.uid).child('isAdmin').val() === true"
    },

    "rateLimits": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    "deletedPosts": {
      "$postId": {
        ".read": false,
        ".write": "auth != null && newData.child('userId').val() === auth.uid && newData.child('deletedBy').val() === auth.uid"
      }
    },

    "hashtags": {
      "$tag": {
        ".read": true,
        ".write": "auth != null",
        "$postId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "fcmTokens": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    },

    "conversations": {
      "$convId": {
        ".read": "auth != null && data.child('participants').hasChild(auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('participants').hasChild(auth.uid) && newData.child('requesterId').val() === auth.uid",
        "participants": { ".validate": "newData.hasChildren()" },
        "requesterId": { ".validate": "newData.isString()" },
        "recipientId": { ".validate": "newData.isString()" },
        "status": {
          ".write": "auth != null && data.parent().child('participants').hasChild(auth.uid) && data.parent().child('recipientId').val() === auth.uid && data.parent().child('status').val() === 'pending' && (newData.val() === 'accepted' || newData.val() === 'rejected')",
          ".validate": "newData.isString() && (newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'rejected')"
        },
        "acceptedBy": { ".write": "auth != null && auth.uid === data.parent().child('recipientId').val() && data.parent().child('status').val() === 'pending'", ".validate": "newData.isString()" },
        "acceptedAt": { ".write": "auth != null && auth.uid === data.parent().child('recipientId').val() && data.parent().child('status').val() === 'pending'", ".validate": "newData.isString()" },
        "rejectedBy": { ".write": "auth != null && auth.uid === data.parent().child('recipientId').val() && data.parent().child('status').val() === 'pending'", ".validate": "newData.isString()" },
        "rejectedAt": { ".write": "auth != null && auth.uid === data.parent().child('recipientId').val() && data.parent().child('status').val() === 'pending'", ".validate": "newData.isString()" },
        "lastMessage": { ".write": "auth != null && data.child('participants').hasChild(auth.uid) && data.child('status').val() !== 'rejected'", ".validate": "newData.isString() || newData.val() === null" },
        "lastMessageTime": { ".write": "auth != null && data.child('participants').hasChild(auth.uid) && data.child('status').val() !== 'rejected'", ".validate": "newData.isString() || newData.val() === null" },
        "lastSenderId": { ".write": "auth != null && data.child('participants').hasChild(auth.uid) && data.child('status').val() !== 'rejected'", ".validate": "newData.isString()" },
        "unreadCounts": { ".write": "auth != null && data.parent().child('participants').hasChild(auth.uid)", ".validate": "newData.hasChildren() || newData.val() === null" },
        "deletedFor": { "$uid": { ".write": "auth.uid === $uid && data.parent().parent().child('participants').hasChild(auth.uid)", ".validate": "newData.isBoolean()" } },
        "$other": { ".validate": true }
      }
    },

    "messages": {
      "$convId": {
        ".read": "auth != null && root.child('conversations').child($convId).child('participants').hasChild(auth.uid)",
        "$msgId": {
          ".write": "auth != null && root.child('conversations').child($convId).child('participants').hasChild(auth.uid) && root.child('conversations').child($convId).child('status').val() !== 'rejected' && root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('accountStatus').val() !== 'banned' && root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('accountStatus').val() !== 'suspended' && !root.child('blocks').child(auth.uid).child(root.child('conversations').child($convId).child('recipientId').val()).exists() && !root.child('blocks').child(root.child('conversations').child($convId).child('recipientId').val()).child(auth.uid).exists() && (root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('messagePrivacy').val() === null || root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('messagePrivacy').val() === 'everyone' || (root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('messagePrivacy').val() === 'following' && root.child('followers').child(root.child('conversations').child($convId).child('recipientId').val()).child(auth.uid).exists()) || (root.child('users').child(root.child('conversations').child($convId).child('recipientId').val()).child('messagePrivacy').val() === 'mutual' && root.child('followers').child(root.child('conversations').child($convId).child('recipientId').val()).child(auth.uid).exists() && root.child('followers').child(auth.uid).child(root.child('conversations').child($convId).child('recipientId').val()).exists())) && ((!data.exists() && newData.child('senderId').val() === auth.uid && (root.child('conversations').child($convId).child('status').val() === 'accepted' || (root.child('conversations').child($convId).child('status').val() === 'pending' && root.child('conversations').child($convId).child('requesterId').val() === auth.uid))) || (data.exists() && data.child('senderId').val() === auth.uid) || (data.exists() && data.child('senderId').val() !== auth.uid && newData.child('read').val() === true))",
          ".validate": "newData.hasChildren(['senderId','text','timestamp','read']) && newData.child('senderId').isString() && newData.child('text').isString() && newData.child('text').val().length <= 1000 && newData.child('timestamp').isString() && newData.child('read').isBoolean()"
        }
      }
    },

    "communities": {
      ".read": "auth != null",
      "$communityId": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerId').val() === auth.uid) || (data.exists() && data.child('ownerId').val() === auth.uid) || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
        ".validate": "newData.hasChildren(['name','ownerId','memberCount','postCount','createdAt']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 80 && newData.child('ownerId').isString() && newData.child('memberCount').isNumber() && newData.child('postCount').isNumber() && newData.child('createdAt').isString()"
      }
    },

    "communityMembers": {
      ".read": "auth != null",
      "$communityId": {
        ".read": "auth != null",
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && (auth.uid === $uid || root.child('communities').child($communityId).child('ownerId').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
          ".validate": "newData.hasChildren(['role','joinedAt']) && newData.child('role').isString() && newData.child('joinedAt').isString()"
        }
      }
    },

    "communityPosts": {
      "$communityId": {
        ".read": "auth != null",
        "$postId": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('communityMembers').child($communityId).child(auth.uid).exists() && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid)) || root.child('communities').child($communityId).child('ownerId').val() === auth.uid || root.child('users').child(auth.uid).child('isAdmin').val() === true)",
          ".validate": "newData.hasChildren(['timestamp','authorId']) && newData.child('timestamp').isString() && newData.child('authorId').isString()"
        }
      }
    },

    "messageUsage": {
      "$uid": {
        "$dayKey": {
          ".read": "auth.uid === $uid",
          ".write": "auth.uid === $uid && newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() >= data.val())",
          ".validate": "$dayKey.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        }
      }
    }
  }
}
